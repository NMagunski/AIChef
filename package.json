{
  "name": "ai-cooking-companion",
  "version": "0.1.0",
  "description": "Bulgarian AI-powered recipe application",
  "scripts": {
    "dev": "next dev --port 4317",
    "build": "next build",
    "start": "next start --port 4317",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "test:unit": "node --experimental-strip-types --experimental-default-type=module --test tests/*.test.ts",
    "validate": "npm run scan:secrets && npm run lint && npm run typecheck && npm run test:unit && npm run test:api && npm run build && npm run test:e2e",
    "test:e2e:report": "playwright show-report",
    "test:api": "node --experimental-strip-types --experimental-default-type=module --test tests/server/*.test.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "ci:validate": "node scripts/ci-validate.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "openai": "^7.36.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "^6.0.3",
    "js-yaml": "4.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=11.15.0 <12"
  },
  "packageManager": "npm@11.15.0"
}
