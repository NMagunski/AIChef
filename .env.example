# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Existing central fallback; keep your current .env.local override unchanged.
OPENAI_MODEL=gpt-5-mini
RECIPE_SEARCH_MODE=ai

# Google web discovery. No live requests are needed for automated tests.
SERPAPI_API_KEY=
WEB_SEARCH_PROVIDER=serpapi

# Per query/model: 0–2 extra AI batches (2 alternatives each), default 1.
AI_DISCOVERY_MAX_EXTRA_BATCHES=1

# Security: local is development-only. In production set redis; missing/invalid
# shared storage fails closed. local-test is allowed only for demo with NO API keys.
API_SECURITY_MODE=local
API_SECURITY_NAMESPACE=aichef
API_REDIS_REST_URL=
API_REDIS_REST_TOKEN=
# At least 32 random characters; stable across all instances. Never NEXT_PUBLIC_.
API_IDENTITY_SECRET=
# shared = one anonymous bucket (safe default, no trusted IP headers).
# trusted-proxy requires a gateway that strips/replaces the headers below and
# injects x-aichef-proxy-secret. Block direct origin access at your gateway.
API_CLIENT_IDENTITY=shared
API_TRUSTED_IP_HEADER=x-real-ip
API_TRUSTED_PROXY_SECRET=

# Endpoint HTTP request limits (cache hits included), per rolling minute.
AI_CLIENT_REQUESTS_PER_MINUTE=5
AI_GLOBAL_REQUESTS_PER_MINUTE=30
WEB_CLIENT_REQUESTS_PER_MINUTE=10
WEB_GLOBAL_REQUESTS_PER_MINUTE=30
# Paid request reservations, calendar UTC day/month. 0 disables new paid work.
AI_CLIENT_REQUESTS_PER_DAY=20
AI_CLIENT_REQUESTS_PER_MONTH=200
AI_GLOBAL_REQUESTS_PER_DAY=500
AI_GLOBAL_REQUESTS_PER_MONTH=5000
WEB_CLIENT_REQUESTS_PER_DAY=50
WEB_CLIENT_REQUESTS_PER_MONTH=500
WEB_GLOBAL_REQUESTS_PER_DAY=1000
WEB_GLOBAL_REQUESTS_PER_MONTH=10000
# Conservative recipe-slot reservations: 3 initial / 2 per extra AI batch.
AI_CLIENT_MAX_RECIPES_PER_DAY=80
AI_CLIENT_MAX_RECIPES_PER_MONTH=800
AI_GLOBAL_MAX_RECIPES_PER_DAY=2000
AI_GLOBAL_MAX_RECIPES_PER_MONTH=20000
AI_MAX_CONCURRENT=5
WEB_MAX_CONCURRENT=10
OPENAI_MAX_OUTPUT_TOKENS=16000
# 1–10 provider pages, 10 results/page; no arbitrary page offsets.
WEB_MAX_PROVIDER_PAGES=10
